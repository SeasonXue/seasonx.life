---
interface Props {
	/** Compact uppercase CF-style label */
	variant?: 'pill' | 'text';
}

const { variant = 'text' } = Astro.props;
---

<button
	type="button"
	class={variant === 'pill' ? 'pill' : 'copy-url-btn'}
	data-copy-url
	data-label="复制链接"
	data-copied="已复制"
	aria-label="复制链接"
>
	<svg
		class="h-3.5 w-3.5"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 256 256"
		fill="currentColor"
		aria-hidden="true"
		width="14"
		height="14"
	>
		<path
			d="M137.54,186.36a8,8,0,0,1,0,11.31l-9.94,10A56,56,0,0,1,48.38,128.4L72.5,104.28A56,56,0,0,1,149.31,102a8,8,0,1,1-10.64,12,40,40,0,0,0-54.85,1.63L59.93,139.72a40,40,0,0,0,56.58,56.58l9.94-9.94A8,8,0,0,1,137.54,186.36Zm70.08-138a56.08,56.08,0,0,0-79.22,0l-9.94,9.95a8,8,0,0,0,11.32,11.31l9.94-9.94a40,40,0,0,1,56.58,56.58L172.18,140.4a40,40,0,0,1-54.85,1.63,8,8,0,1,0-10.64,12,56,56,0,0,0,76.81-2.23l24.12-24.12A56.08,56.08,0,0,0,207.62,48.38Z"
		></path>
	</svg>
	<span data-copy-label>复制链接</span>
</button>

<script>
	document.querySelectorAll('[data-copy-url]').forEach((btn) => {
		const label = btn.querySelector('[data-copy-label]');
		const idle = btn.getAttribute('data-label') || '复制链接';
		const done = btn.getAttribute('data-copied') || '已复制';
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				btn.setAttribute('data-copied', '');
				if (label) label.textContent = done;
				setTimeout(() => {
					btn.removeAttribute('data-copied');
					if (label) label.textContent = idle;
				}, 1600);
			} catch {
				if (label) label.textContent = '失败';
			}
		});
	});
</script>
