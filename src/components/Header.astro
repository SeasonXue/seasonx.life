---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="sticky top-0 z-50 border-b border-[var(--border-soft)] bg-[var(--parchment)]/90 backdrop-blur-md">
	<nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-3.5 sm:px-8">
		<a
			href="/"
			class="text-base font-medium tracking-tight text-[var(--fg)] no-underline transition-colors hover:text-[var(--accent)]"
		>
			{SITE_TITLE}
		</a>

		<div class="flex items-center gap-1 sm:gap-2">
			<div class="hidden items-center gap-0.5 sm:flex">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">文章</HeaderLink>
				<HeaderLink href="/archive">归档</HeaderLink>
				<HeaderLink href="/tags">标签</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
			</div>
			<a
				href="/search"
				class="inline-flex h-9 w-9 items-center justify-center rounded-lg text-[var(--stone)] transition-colors hover:bg-[var(--brand-tint)] hover:text-[var(--brand)]"
				aria-label="搜索"
			>
				<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
				</svg>
			</a>
			{/* 移动端菜单 */}
			<details class="relative sm:hidden group">
				<summary
					class="inline-flex h-9 w-9 list-none items-center justify-center rounded-lg text-[var(--stone)] cursor-pointer transition-colors hover:bg-[var(--brand-tint)] hover:text-[var(--brand)] [&::-webkit-details-marker]:hidden"
					aria-label="菜单"
				>
					<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
					</svg>
				</summary>
				<div
					class="absolute right-0 mt-2 w-40 rounded-lg border border-[var(--border-soft)] bg-[var(--ivory)] p-2 shadow-[var(--shadow-whisper)] flex flex-col gap-0.5"
				>
					<HeaderLink href="/">首页</HeaderLink>
					<HeaderLink href="/blog">文章</HeaderLink>
					<HeaderLink href="/archive">归档</HeaderLink>
					<HeaderLink href="/tags">标签</HeaderLink>
					<HeaderLink href="/categories">分类</HeaderLink>
					<HeaderLink href="/about">关于</HeaderLink>
				</div>
			</details>
		</div>
	</nav>
</header>
