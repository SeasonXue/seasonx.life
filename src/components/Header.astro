---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const links = [
	{ href: '/', label: '首页' },
	{ href: '/blog', label: '文章' },
	{ href: '/archive', label: '归档' },
	{ href: '/tags', label: '标签' },
	{ href: '/categories', label: '分类' },
	{ href: '/about', label: '关于' },
] as const;
---

<header
	class="sticky top-0 z-50 h-[var(--header-h)] border-b border-[var(--border-soft)] bg-[var(--parchment)]/95 backdrop-blur-md"
	data-site-header
>
	<div class="page-frame flex h-full items-center justify-between gap-4 px-[var(--page-pad-x)]">
		<a
			href="/"
			class="shrink-0 text-base font-medium tracking-tight text-[var(--fg)] no-underline transition-colors duration-150 hover:text-[var(--accent)]"
		>
			{SITE_TITLE}
		</a>

		<nav class="hidden items-center gap-0.5 md:flex" aria-label="主导航">
			{links.map((l) => <HeaderLink href={l.href}>{l.label}</HeaderLink>)}
		</nav>

		<div class="flex items-center gap-1">
			<a
				href="/search"
				class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--stone)] transition-colors duration-150 hover:bg-[var(--brand-tint)] hover:text-[var(--brand)]"
				aria-label="搜索"
			>
				<svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
				</svg>
			</a>

			<button
				type="button"
				id="mobile-menu-btn"
				class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--stone)] transition-colors duration-150 hover:bg-[var(--brand-tint)] hover:text-[var(--brand)] md:hidden"
				aria-label="打开菜单"
				aria-expanded="false"
				aria-controls="mobile-menu"
				data-open-label="打开菜单"
				data-close-label="关闭菜单"
			>
				<svg class="menu-icon-open h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
				</svg>
				<svg class="menu-icon-close hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</div>
</header>

{/* Full-screen mobile drawer — CF style */}
<div
	id="mobile-menu"
	class="fixed inset-0 z-40 flex flex-col bg-[var(--parchment)] pt-[var(--header-h)] md:hidden"
	aria-hidden="true"
	inert
	hidden
>
	<nav class="flex-1 overflow-y-auto px-4 py-2" aria-label="移动导航">
		<ul class="m-0 list-none p-0">
			{
				links.map((l) => (
					<li>
						<a
							href={l.href}
							class="flex items-center justify-between border-b border-[var(--border-soft)] px-4 py-4 text-xl text-[var(--fg)] no-underline transition-colors duration-100 hover:text-[var(--accent)]"
						>
							<span>{l.label}</span>
							<svg class="h-4 w-4 text-[var(--stone)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
							</svg>
						</a>
					</li>
				))
			}
			<li>
				<a
					href="/search"
					class="flex items-center justify-between border-b border-[var(--border-soft)] px-4 py-4 text-xl text-[var(--fg)] no-underline transition-colors duration-100 hover:text-[var(--accent)]"
				>
					<span>搜索</span>
					<svg class="h-4 w-4 text-[var(--stone)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
					</svg>
				</a>
			</li>
		</ul>
	</nav>
	<div class="border-t border-[var(--border-soft)] px-6 py-5">
		<a href="/rss.xml" class="text-sm text-[var(--stone)] no-underline transition-colors hover:text-[var(--brand)]">
			RSS 订阅
		</a>
	</div>
</div>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	const openIcon = btn?.querySelector('.menu-icon-open');
	const closeIcon = btn?.querySelector('.menu-icon-close');

	function openMenu() {
		if (!btn || !menu) return;
		menu.hidden = false;
		menu.inert = false;
		menu.setAttribute('aria-hidden', 'false');
		btn.setAttribute('aria-expanded', 'true');
		btn.setAttribute('aria-label', btn.dataset.closeLabel ?? '关闭菜单');
		openIcon?.classList.add('hidden');
		closeIcon?.classList.remove('hidden');
		document.documentElement.classList.add('menu-open');
	}

	function closeMenu() {
		if (!btn || !menu) return;
		menu.hidden = true;
		menu.inert = true;
		menu.setAttribute('aria-hidden', 'true');
		btn.setAttribute('aria-expanded', 'false');
		btn.setAttribute('aria-label', btn.dataset.openLabel ?? '打开菜单');
		openIcon?.classList.remove('hidden');
		closeIcon?.classList.add('hidden');
		document.documentElement.classList.remove('menu-open');
	}

	btn?.addEventListener('click', () => {
		const open = btn.getAttribute('aria-expanded') === 'true';
		open ? closeMenu() : openMenu();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') closeMenu();
	});

	// Close on nav click
	menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
</script>
