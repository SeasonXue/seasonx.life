---
import FormattedDate from './FormattedDate.astro';
import { formatReadingTime } from '../utils/reading-time';

interface Props {
	pubDate: Date;
	updatedDate?: Date;
	readingMinutes?: number;
	tags?: string[];
	category?: string;
}

const { pubDate, updatedDate, readingMinutes, tags = [], category } = Astro.props;
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-sm text-[var(--stone)]">
	<span class="inline-flex items-center gap-1.5 tabular-nums">
		<FormattedDate date={pubDate} />
	</span>
	{
		updatedDate && (
			<span class="tabular-nums">
				更新于 <FormattedDate date={updatedDate} />
			</span>
		)
	}
	{
		readingMinutes != null && (
			<span class="inline-flex items-center gap-1.5">
				{formatReadingTime(readingMinutes)}
			</span>
		)
	}
	{
		category && (
			<a
				href={`/categories/${encodeURIComponent(category)}/`}
				class="tag"
			>
				{category}
			</a>
		)
	}
</div>
{
	tags.length > 0 && (
		<div class="mt-2.5 flex flex-wrap gap-1.5">
			{tags.map((tag) => (
				<a
					href={`/tags/${encodeURIComponent(tag)}/`}
					class="tag tag-soft"
				>
					#{tag}
				</a>
			))}
		</div>
	)
}
