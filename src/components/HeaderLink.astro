---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const normalized = pathname.endsWith('/') && pathname !== '/' ? pathname.slice(0, -1) : pathname;
const hrefPath = typeof href === 'string' ? href.replace(/\/$/, '') || '/' : href;
const isActive =
	hrefPath === normalized ||
	(hrefPath !== '/' && typeof hrefPath === 'string' && normalized.startsWith(hrefPath));
---

<a
	href={href}
	class:list={[
		'inline-block px-3 py-1 text-sm font-medium no-underline transition-colors duration-150 rounded-md',
		isActive ? 'text-[var(--accent)]' : 'text-[var(--stone)] hover:text-[var(--brand)]',
		className,
	]}
	{...props}
>
	<slot />
</a>
