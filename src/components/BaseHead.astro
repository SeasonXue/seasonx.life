---
import '../styles/global.css';
import '../styles/article.css';
import '../styles/feed.css';
import type { ImageMetadata } from 'astro';
import { CF_ANALYTICS_TOKEN, SITE_AUTHOR, SITE_TITLE, SITE_URL } from '../consts';

interface Props {
	title: string;
	description: string;
	/** Optimized asset metadata or a public path / absolute URL (e.g. Live Photo still) */
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	pubDate?: Date;
	updatedDate?: Date;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE_URL);
const {
	title,
	description,
	image,
	type = 'website',
	pubDate,
	updatedDate,
} = Astro.props;

const fullTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const siteBase = Astro.site ?? SITE_URL;
const ogImage = image
	? typeof image === 'string'
		? new URL(image, siteBase)
		: new URL(image.src, siteBase)
	: undefined;

const jsonLd =
	type === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'BlogPosting',
				headline: title,
				description,
				...(ogImage && { image: ogImage.href }),
				datePublished: pubDate?.toISOString(),
				dateModified: (updatedDate ?? pubDate)?.toISOString(),
				author: {
					'@type': 'Person',
					name: SITE_AUTHOR,
				},
				publisher: {
					'@type': 'Person',
					name: SITE_AUTHOR,
				},
				mainEntityOfPage: {
					'@type': 'WebPage',
					'@id': canonicalURL.href,
				},
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				description,
				url: SITE_URL,
				author: {
					'@type': 'Person',
					name: SITE_AUTHOR,
				},
			};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site ?? SITE_URL)}
/>
<meta name="generator" content={Astro.generator} />
<meta name="author" content={SITE_AUTHOR} />
<meta name="color-scheme" content="light" />
<meta name="theme-color" content="#f5f4ed" />

{/* Kami fonts: 仓耳今楷 + JetBrains Mono，self-hosted under /fonts */}
<link
	rel="preload"
	href="/fonts/TsangerJinKai02.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<link
	rel="preload"
	href="/fonts/JetBrainsMono.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>

<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content="zh_CN" />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

{
	CF_ANALYTICS_TOKEN && (
		<script
			is:inline
			type="module"
			src="https://static.cloudflareinsights.com/beacon.min.js"
			data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
		/>
	)
}
