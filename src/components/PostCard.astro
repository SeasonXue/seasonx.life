---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SITE_AUTHOR } from '../consts';
import { getLive } from '../utils/live-photo';
import LivePhoto from './LivePhoto.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	/** Full-width featured row (first post only) */
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, heroLive } = post.data;
const href = `/blog/${post.id}/`;
const dateLabel = pubDate.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
const heroLiveMeta = heroLive ? getLive(heroLive) : undefined;
// Initials for avatar (CF byline)
const initials = SITE_AUTHOR.replace(/[^\p{L}\p{N}\s]/gu, '')
	.split(/\s+/)
	.filter(Boolean)
	.slice(0, 2)
	.map((w) => w[0])
	.join('')
	.toUpperCase() || 'S';
---

{
	featured ? (
		<article class="feed-featured group">
			<div class="feed-featured__copy">
				<time class="feed-date" datetime={pubDate.toISOString()}>
					{dateLabel}
				</time>
				<a href={href} class="feed-title-link group/title">
					<h2 class="feed-featured__title">{title}</h2>
				</a>
				<p class="feed-featured__excerpt">{description}</p>
				<div class="feed-byline">
					<span class="feed-avatar" aria-hidden="true">
						{initials}
					</span>
					<span class="feed-byline-name">{SITE_AUTHOR}</span>
				</div>
			</div>
			{heroLiveMeta ? (
				/* Not wrapped in <a> — Live Photo needs click / hover / LIVE controls */
				<div class="feed-featured__media feed-featured__media--live">
					<LivePhoto
						meta={heroLiveMeta}
						variant="featured"
						alt={title}
						loading="eager"
						autoplayOnce
					/>
				</div>
			) : (
				heroImage && (
					<a href={href} class="feed-featured__media" tabindex="-1" aria-hidden="true">
						<div class="feed-featured__frame">
							<Image
								src={heroImage}
								alt=""
								width={960}
								height={540}
								class="aspect-[16/9] h-full w-full object-cover"
								loading="eager"
								fetchpriority="high"
							/>
						</div>
					</a>
				)
			)}
		</article>
	) : (
		<article class="feed-cell">
			<time class="feed-date" datetime={pubDate.toISOString()}>
				{dateLabel}
			</time>
			<a href={href} class="feed-title-link group/title">
				<h2 class="feed-cell__title">{title}</h2>
			</a>
			<p class="feed-cell__excerpt">{description}</p>
			<div class="feed-byline">
				<span class="feed-avatar" aria-hidden="true">
					{initials}
				</span>
				<span class="feed-byline-name">{SITE_AUTHOR}</span>
			</div>
		</article>
	)
}
