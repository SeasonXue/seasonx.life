---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
	/** Extra class on root nav */
	class?: string;
}

const { headings, class: className } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length > 0 && (
		<nav class:list={['otp', className]} aria-label="本页目录" data-otp>
			<p class="otp-label">本页目录</p>
			<ul class="otp-list">
				{items.map((h) => (
					<li class:list={[h.depth === 3 && 'otp-h3']}>
						<a href={`#${h.slug}`} data-otp-link data-slug={h.slug}>
							{h.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

{
	items.length > 0 && (
		<script>
			const links = Array.from(document.querySelectorAll('[data-otp-link]')) as HTMLAnchorElement[];
			if (links.length) {
				const targets = links
					.map((a) => {
						const id = a.getAttribute('data-slug') || '';
						const el = document.getElementById(id);
						return el ? { a, el } : null;
					})
					.filter(Boolean) as { a: HTMLAnchorElement; el: HTMLElement }[];

				const setActive = (slug: string | null) => {
					links.forEach((a) => {
						a.dataset.active = a.getAttribute('data-slug') === slug ? 'true' : 'false';
					});
				};

				const obs = new IntersectionObserver(
					(entries) => {
						const visible = entries
							.filter((e) => e.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
						if (visible[0]?.target?.id) setActive(visible[0].target.id);
					},
					{ rootMargin: '-20% 0px -70% 0px', threshold: [0, 1] },
				);

				targets.forEach(({ el }) => obs.observe(el));

				// Initial
				const hash = location.hash.slice(1);
				if (hash) setActive(hash);
				else if (targets[0]) setActive(targets[0].el.id);
			}
		</script>
	)
}
