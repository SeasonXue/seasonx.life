---
/**
 * Web Live Photo: still frame + short video (optional ambient audio).
 *
 * Prefer meta from `pnpm live:import` + `getLive(slug)`:
 *   import { getLive } from '../utils/live-photo';
 *   <LivePhoto meta={getLive('2025-04-18-181243')} />
 *
 * Under the frame (3 lines): local time · address (place.label) · lat/lon.
 * Alt is on the image (a11y) and shown as a hover title on the frame.
 */
import type { LivePhotoMeta } from '../utils/live-photo';
import {
	formatLiveLocalTime,
	formatLiveLocation,
	toLivePhotoProps,
} from '../utils/live-photo';

type Props = {
	/**
	 * Meta written by `pnpm live:import`.
	 * When set, fills photo/video/geo; explicit props still override.
	 */
	meta?: LivePhotoMeta;
	/** Still image URL (JPEG / WebP recommended) */
	photo?: string;
	/** Short MP4 (H.264, ~1.5–3s; AAC audio recommended) */
	video?: string;
	/** Description — img alt + hover title on the frame */
	alt?: string;
	/** Width / height hints for aspect ratio (optional) */
	width?: number;
	height?: number;
	/**
	 * When true, play once automatically the first time the element
	 * enters the viewport (still respects prefers-reduced-motion).
	 * Autoplay is always muted (browser policy).
	 */
	autoplayOnce?: boolean;
	/**
	 * Play ambient audio when possible (default true).
	 * Click / long-press / badge use sound; hover tries sound then falls back to muted.
	 */
	sound?: boolean;
	/** Address line (default from meta: place.label) */
	location?: string;
	/** Local capture time label (default from meta source.capturedAt) */
	capturedAtLocal?: string;
	/** WGS84 latitude */
	latitude?: number;
	/** WGS84 longitude */
	longitude?: number;
	/** Optional maps link; defaults to Apple Maps when lat/lon present */
	mapsUrl?: string;
	/**
	 * `default` — article/embed spacing.
	 * `wall` — tight margins for photo-wall grids.
	 */
	variant?: 'default' | 'wall';
};

const props = Astro.props;
const fromMeta = props.meta ? toLivePhotoProps(props.meta) : null;
const variant = props.variant ?? 'default';

const photo = props.photo ?? fromMeta?.photo;
const video = props.video ?? fromMeta?.video;
const alt = props.alt ?? fromMeta?.alt ?? 'Live Photo';
const width = props.width ?? fromMeta?.width;
const height = props.height ?? fromMeta?.height;
const autoplayOnce = props.autoplayOnce ?? false;
const sound = props.sound ?? true;
const location =
	props.location ??
	fromMeta?.location ??
	(props.meta ? formatLiveLocation(props.meta.place) : undefined);
const capturedAtLocal =
	props.capturedAtLocal ??
	fromMeta?.capturedAtLocal ??
	(props.meta
		? formatLiveLocalTime(props.meta.source?.capturedAt, props.meta.source?.capturedAtUtc)
		: undefined);
const latitude = props.latitude ?? fromMeta?.latitude;
const longitude = props.longitude ?? fromMeta?.longitude;
const mapsUrl = props.mapsUrl ?? fromMeta?.mapsUrl;

if (!photo || !video) {
	throw new Error('LivePhoto requires photo + video (or a meta object from pnpm live:import)');
}

const hasGeo =
	typeof latitude === 'number' &&
	typeof longitude === 'number' &&
	Number.isFinite(latitude) &&
	Number.isFinite(longitude);

const resolvedMapsUrl =
	mapsUrl ??
	(hasGeo
		? `https://maps.apple.com/?ll=${latitude},${longitude}${location ? `&q=${encodeURIComponent(location)}` : ''}`
		: undefined);

const coordLabel = hasGeo
	? `${latitude! >= 0 ? 'N' : 'S'} ${Math.abs(latitude!).toFixed(4)}° · ${longitude! >= 0 ? 'E' : 'W'} ${Math.abs(longitude!).toFixed(4)}°`
	: undefined;

const showMeta = Boolean(capturedAtLocal || location || hasGeo);

/** machine-readable datetime if parseable */
const capturedAtIso = props.meta?.source?.capturedAt ?? props.meta?.source?.capturedAtUtc ?? undefined;
---

<figure
	class:list={['live-photo', 'not-prose', variant === 'wall' && 'live-photo--wall']}
	data-live-photo
	data-autoplay-once={autoplayOnce ? '' : undefined}
	data-sound={sound ? '' : undefined}
>
	<div class="live-photo__frame" title={alt}>
		<img
			class="live-photo__still"
			src={photo}
			alt={alt}
			title={alt}
			width={width}
			height={height}
			loading="lazy"
			decoding="async"
			draggable="false"
		/>
		<video
			class="live-photo__motion"
			src={video}
			playsinline
			preload="metadata"
			loop={false}
			aria-hidden="true"
			tabindex="-1"
		></video>

		<button
			type="button"
			class="live-photo__badge"
			aria-label="播放 Live 动效"
			aria-pressed="false"
			data-live-toggle
		>
			<span class="live-photo__badge-dot" aria-hidden="true"></span>
			<span class="live-photo__badge-text">LIVE</span>
		</button>

		<p class="live-photo__hint" data-live-hint hidden>
			长按或点击 LIVE 查看动态（含声音）
		</p>
	</div>
	{showMeta && (
		<figcaption class="live-photo__meta">
			{/* 1 · time */}
			{capturedAtLocal && (
				<p class="live-photo__time">
					<span class="live-photo__time-icon" aria-hidden="true">
						<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
							<path
								d="M12 2a10 10 0 1 0 10 10A10.011 10.011 0 0 0 12 2zm0 18a8 8 0 1 1 8-8 8.009 8.009 0 0 1-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
							></path>
						</svg>
					</span>
					<time datetime={capturedAtIso}>{capturedAtLocal}</time>
				</p>
			)}
			{/* 2 · address (place.label) */}
			{location && (
				<p class="live-photo__location">
					{resolvedMapsUrl ? (
						<a
							href={resolvedMapsUrl}
							class="live-photo__location-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							<span class="live-photo__location-pin" aria-hidden="true">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
									<path
										d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"
									></path>
								</svg>
							</span>
							<span class="live-photo__location-text">{location}</span>
						</a>
					) : (
						<>
							<span class="live-photo__location-pin" aria-hidden="true">
								<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
									<path
										d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6a2.5 2.5 0 0 1 0 5.5z"
									></path>
								</svg>
							</span>
							<span class="live-photo__location-text">{location}</span>
						</>
					)}
				</p>
			)}
			{/* 3 · coordinates */}
			{coordLabel && (
				<p class="live-photo__coords">
					{resolvedMapsUrl ? (
						<a
							href={resolvedMapsUrl}
							class="live-photo__coords-link"
							target="_blank"
							rel="noopener noreferrer"
						>
							{coordLabel}
						</a>
					) : (
						coordLabel
					)}
				</p>
			)}
		</figcaption>
	)}
</figure>

<style>
	.live-photo {
		margin: 2rem 0;
		min-width: 0;
		max-width: 100%;
	}

	.live-photo--wall {
		margin: 0;
		height: 100%;
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.live-photo--wall .live-photo__frame {
		flex: 1 1 auto;
	}

	.live-photo--wall .live-photo__meta {
		margin-top: 0.4rem;
		gap: 0.18rem;
	}

	.live-photo--wall .live-photo__time,
	.live-photo--wall .live-photo__location {
		font-size: 0.7rem;
	}

	.live-photo--wall .live-photo__coords {
		font-size: 0.65rem;
	}

	.live-photo__frame {
		position: relative;
		overflow: hidden;
		border-radius: 0.5rem;
		border: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
		background: var(--ivory);
		/* Avoid iOS callout / image save on long-press while playing */
		-webkit-touch-callout: none;
		user-select: none;
		touch-action: manipulation;
		cursor: pointer;
	}

	.live-photo__still,
	.live-photo__motion {
		display: block;
		width: 100%;
		height: auto;
		vertical-align: middle;
	}

	.live-photo__still {
		position: relative;
		z-index: 1;
	}

	.live-photo__motion {
		position: absolute;
		inset: 0;
		z-index: 2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.12s ease;
	}

	.live-photo[data-playing] .live-photo__motion {
		opacity: 1;
	}

	.live-photo[data-playing] .live-photo__still {
		/* Keep layout; video sits on top */
		visibility: hidden;
	}

	.live-photo__badge {
		position: absolute;
		top: 0.65rem;
		left: 0.65rem;
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.28rem 0.5rem 0.28rem 0.4rem;
		border: 0;
		border-radius: 999px;
		background: color-mix(in srgb, #0a0a0a 62%, transparent);
		color: #fff;
		font-family: var(--font-mono), ui-monospace, monospace;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1;
		cursor: pointer;
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.live-photo__badge:hover,
	.live-photo__badge:focus-visible {
		background: color-mix(in srgb, #0a0a0a 78%, transparent);
		outline: none;
	}

	.live-photo__badge:focus-visible {
		box-shadow: 0 0 0 2px var(--brand);
	}

	.live-photo[data-playing] .live-photo__badge {
		background: color-mix(in srgb, var(--brand) 88%, #000);
	}

	.live-photo__badge-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: #ff3b30;
		box-shadow: 0 0 0 0 color-mix(in srgb, #ff3b30 50%, transparent);
	}

	.live-photo[data-playing] .live-photo__badge-dot {
		animation: live-pulse 1.1s ease-out infinite;
	}

	@keyframes live-pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, #ff3b30 55%, transparent);
		}
		70% {
			box-shadow: 0 0 0 0.35rem transparent;
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}

	.live-photo__hint {
		position: absolute;
		right: 0.65rem;
		bottom: 0.65rem;
		z-index: 3;
		margin: 0;
		padding: 0.3rem 0.55rem;
		border-radius: 0.35rem;
		background: color-mix(in srgb, #0a0a0a 55%, transparent);
		color: #fff;
		font-size: 0.7rem;
		line-height: 1.3;
		letter-spacing: 0.02em;
		pointer-events: none;
		opacity: 0;
		transform: translateY(0.15rem);
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	.live-photo[data-show-hint] .live-photo__hint {
		opacity: 1;
		transform: translateY(0);
	}

	.live-photo__meta {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0.22rem;
		margin-top: 0.55rem;
		text-align: center;
		min-width: 0;
		width: 100%;
	}

	.live-photo__time,
	.live-photo__location,
	.live-photo__coords {
		margin: 0;
		max-width: 100%;
		font-size: 0.75rem;
		font-family: var(--font-mono), ui-monospace, monospace;
		color: var(--stone);
		letter-spacing: 0;
		line-height: 1.35;
		/* single line + ellipsis on overflow */
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.live-photo__time {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		width: 100%;
	}

	.live-photo__time-icon {
		display: inline-flex;
		flex-shrink: 0;
		opacity: 0.75;
	}

	.live-photo__time time {
		font: inherit;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.live-photo__location {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		width: 100%;
	}

	.live-photo__location-link {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		min-width: 0;
		max-width: 100%;
		color: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
		overflow: hidden;
	}

	.live-photo__location-link:hover,
	.live-photo__location-link:focus-visible,
	.live-photo__coords-link:hover,
	.live-photo__coords-link:focus-visible {
		color: var(--brand);
		outline: none;
	}

	.live-photo__location-pin {
		display: inline-flex;
		flex-shrink: 0;
		opacity: 0.75;
	}

	.live-photo__location-text {
		font-family: inherit;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.live-photo__coords {
		width: 100%;
		opacity: 0.7;
		font-size: 0.7rem;
	}

	.live-photo__coords-link {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		color: inherit;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.live-photo__motion {
			transition: none;
		}

		.live-photo[data-playing] .live-photo__badge-dot {
			animation: none;
		}
	}
</style>

<script>
	type LiveRoot = HTMLElement & {
		_liveBound?: boolean;
	};

	const LONG_PRESS_MS = 280;
	const HINT_STORAGE_KEY = 'live-photo-hint-seen';

	function prefersReducedMotion(): boolean {
		return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	}

	function canHover(): boolean {
		return window.matchMedia('(hover: hover) and (pointer: fine)').matches;
	}

	function initLivePhoto(root: LiveRoot) {
		if (root._liveBound) return;
		root._liveBound = true;

		const video = root.querySelector<HTMLVideoElement>('.live-photo__motion');
		const toggle = root.querySelector<HTMLButtonElement>('[data-live-toggle]');
		const hint = root.querySelector<HTMLElement>('[data-live-hint]');
		const frame = root.querySelector<HTMLElement>('.live-photo__frame');
		if (!video || !toggle || !frame) return;

		const soundEnabled = root.hasAttribute('data-sound');
		let longPressTimer: number | null = null;
		let pressActive = false;
		/** True when current playback was started by a long-press hold */
		let holdPlaying = false;
		/** Suppress the click that follows a long-press gesture */
		let suppressClick = false;
		let playing = false;

		const setPlaying = (next: boolean) => {
			playing = next;
			if (next) {
				root.setAttribute('data-playing', '');
				toggle.setAttribute('aria-pressed', 'true');
				toggle.setAttribute('aria-label', '停止 Live 动效');
			} else {
				root.removeAttribute('data-playing');
				toggle.setAttribute('aria-pressed', 'false');
				toggle.setAttribute('aria-label', '播放 Live 动效');
			}
		};

		const stop = () => {
			video.pause();
			try {
				video.currentTime = 0;
			} catch {
				/* ignore seek errors before metadata */
			}
			// Reset mute so the next intentional play can try with sound again
			video.muted = false;
			holdPlaying = false;
			setPlaying(false);
		};

		/**
		 * @param mode 'sound' = prefer audio (user gesture);
		 *             'soft' = try sound then muted (hover);
		 *             'muted' = force muted (autoplay policy)
		 */
		const play = async (mode: 'sound' | 'soft' | 'muted' = 'sound') => {
			const wantSound = soundEnabled && mode !== 'muted';
			const tryMutedFallback = mode === 'soft' || mode === 'muted';

			try {
				if (video.readyState < 2) {
					video.load();
				}
				video.muted = !wantSound;
				video.volume = 1;
				await video.play();
				setPlaying(true);
				hideHint();
			} catch {
				if (wantSound && tryMutedFallback) {
					try {
						video.muted = true;
						await video.play();
						setPlaying(true);
						hideHint();
						return;
					} catch {
						/* fall through */
					}
				}
				setPlaying(false);
			}
		};

		const hideHint = () => {
			root.removeAttribute('data-show-hint');
			if (hint) hint.hidden = true;
			try {
				localStorage.setItem(HINT_STORAGE_KEY, '1');
			} catch {
				/* private mode */
			}
		};

		const maybeShowHint = () => {
			if (prefersReducedMotion() || canHover()) return;
			try {
				if (localStorage.getItem(HINT_STORAGE_KEY)) return;
			} catch {
				return;
			}
			if (hint) {
				hint.hidden = false;
				root.setAttribute('data-show-hint', '');
				window.setTimeout(hideHint, 4000);
			}
		};

		video.addEventListener('ended', () => {
			stop();
		});

		// Desktop hover: try sound (usually blocked) → muted fallback
		if (canHover() && !prefersReducedMotion()) {
			root.addEventListener('mouseenter', () => {
				void play('soft');
			});
			root.addEventListener('mouseleave', () => {
				stop();
			});
		}

		const onToggleClick = (e: MouseEvent) => {
			e.stopPropagation();
			if (suppressClick) {
				suppressClick = false;
				e.preventDefault();
				return;
			}
			if (playing) stop();
			else void play('sound');
		};

		toggle.addEventListener('click', onToggleClick);

		// Frame short-tap: sound on coarse pointers; on fine pointer also allow
		// click with sound (hover may have been muted-only)
		frame.addEventListener('click', (e) => {
			const t = e.target as HTMLElement | null;
			if (t?.closest('[data-live-toggle]')) return;
			if (suppressClick) {
				suppressClick = false;
				e.preventDefault();
				return;
			}
			if (canHover()) {
				// Re-play with sound on explicit click while hovering
				if (playing && !video.muted) {
					stop();
					return;
				}
				void play('sound');
				return;
			}
			if (playing) stop();
			else void play('sound');
		});

		const clearLongPress = () => {
			if (longPressTimer != null) {
				window.clearTimeout(longPressTimer);
				longPressTimer = null;
			}
		};

		const onPointerDown = (e: PointerEvent) => {
			if (e.pointerType === 'mouse') return;
			if (prefersReducedMotion()) return;
			pressActive = true;
			holdPlaying = false;
			clearLongPress();
			longPressTimer = window.setTimeout(() => {
				if (!pressActive) return;
				holdPlaying = true;
				suppressClick = true;
				void play('sound');
			}, LONG_PRESS_MS);
		};

		const endHold = () => {
			pressActive = false;
			clearLongPress();
			// Live Photo style: release ends hold-playback
			if (holdPlaying) {
				suppressClick = true;
				stop();
			}
		};

		frame.addEventListener('pointerdown', onPointerDown);
		frame.addEventListener('pointerup', endHold);
		frame.addEventListener('pointercancel', endHold);
		frame.addEventListener('pointerleave', (e) => {
			if ((e as PointerEvent).pointerType === 'mouse') return;
			endHold();
		});

		// Avoid the iOS callout menu while long-pressing
		frame.addEventListener('contextmenu', (e) => {
			if (!canHover()) e.preventDefault();
		});

		maybeShowHint();

		// Optional: play once when scrolled into view (muted — autoplay policy)
		if (root.hasAttribute('data-autoplay-once') && !prefersReducedMotion()) {
			const io = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							void play('muted');
							io.disconnect();
							break;
						}
					}
				},
				{ threshold: 0.55 },
			);
			io.observe(root);
		}
	}

	function boot() {
		document.querySelectorAll<LiveRoot>('[data-live-photo]').forEach(initLivePhoto);
	}

	boot();
	document.addEventListener('astro:page-load', boot);
</script>
