---
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border-soft)]">
	<div
		class="mx-auto flex max-w-3xl flex-col gap-4 px-5 py-10 sm:flex-row sm:items-end sm:justify-between sm:px-8"
	>
		<div class="text-sm text-[var(--stone)] leading-relaxed">
			<p class="text-[var(--dark-warm)] font-medium">
				&copy; {year} {SITE_AUTHOR}
			</p>
			<p class="mt-1">
				基于
				<a
					href="https://astro.build"
					class="text-[var(--accent)] no-underline hover:underline"
					target="_blank"
					rel="noopener"
					>Astro</a
				>
				构建 · 部署于 Cloudflare Pages
			</p>
		</div>
		{
			(SOCIAL_LINKS.github || SOCIAL_LINKS.twitter || SOCIAL_LINKS.email) && (
				<div class="flex items-center gap-4">
					{SOCIAL_LINKS.github && (
						<a
							href={SOCIAL_LINKS.github}
							target="_blank"
							rel="noopener noreferrer"
							class="text-[var(--stone)] transition-colors hover:text-[var(--brand)]"
							aria-label="GitHub"
						>
							<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
								<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
							</svg>
						</a>
					)}
					{SOCIAL_LINKS.twitter && (
						<a
							href={SOCIAL_LINKS.twitter}
							target="_blank"
							rel="noopener noreferrer"
							class="text-[var(--stone)] transition-colors hover:text-[var(--brand)]"
							aria-label="Twitter / X"
						>
							<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
								<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
							</svg>
						</a>
					)}
					{SOCIAL_LINKS.email && (
						<a
							href={`mailto:${SOCIAL_LINKS.email}`}
							class="text-[var(--stone)] transition-colors hover:text-[var(--brand)]"
							aria-label="Email"
						>
							<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
							</svg>
						</a>
					)}
				</div>
			)
		}
	</div>
</footer>
