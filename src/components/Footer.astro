---
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="mt-auto section-rule-top">
	<div
		class="page-frame flex flex-col gap-6 px-[var(--page-pad-x)] py-10 sm:flex-row sm:items-end sm:justify-between sm:py-12"
	>
		<div class="text-sm leading-relaxed text-[var(--stone)]">
			<p class="m-0 font-medium text-[var(--dark-warm)]">
				&copy; {year} {SITE_AUTHOR}
			</p>
			<p class="mt-1 m-0">
				基于
				<a
					href="https://astro.build"
					class="text-[var(--accent)] no-underline hover:underline"
					target="_blank"
					rel="noopener"
					>Astro</a
				>
				构建 · 部署于 Cloudflare Pages
			</p>
		</div>

		<div class="flex flex-wrap items-center gap-4">
			<a
				href="/rss.xml"
				class="text-sm text-[var(--stone)] no-underline transition-colors hover:text-[var(--brand)]"
			>
				RSS
			</a>
			{
				SOCIAL_LINKS.github && (
					<a
						href={SOCIAL_LINKS.github}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[var(--stone)] transition-colors hover:text-[var(--brand)]"
						aria-label="GitHub"
					>
						<svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
							<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
						</svg>
					</a>
				)
			}
			{
				SOCIAL_LINKS.twitter && (
					<a
						href={SOCIAL_LINKS.twitter}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[var(--stone)] transition-colors hover:text-[var(--brand)]"
						aria-label="Twitter / X"
					>
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
							<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z" />
						</svg>
					</a>
				)
			}
			{
				SOCIAL_LINKS.jike && (
					<a
						href={SOCIAL_LINKS.jike}
						target="_blank"
						rel="noopener noreferrer"
						class="text-[var(--stone)] transition-colors hover:text-[var(--brand)]"
						aria-label="即刻"
					>
						{/* Official Jike brand mark (monochrome). Source: okjike logo (also on pnpm.io users wall). */}
						<svg viewBox="12 8 16 24" width="14" height="18" fill="currentColor" aria-hidden="true">
							<path
								d="M.989 20.83a.52.52 0 0 1-.054.01l1.72 1.677c1.654-.152 3.273-.587 4.465-1.018 1.193-.432 2.174-.987 2.945-1.667a6.227 6.227 0 0 0 1.713-2.45c.37-.954.555-2.055.555-3.303V7.915c0-1.39.005-2.595.015-3.614.01-1.02.016-1.94.016-2.763L10.44.003c0 .821-.005 1.741-.015 2.76-.01 1.019-.015 2.224-.015 3.614v6.164c0 1.248-.185 2.349-.555 3.302a6.227 6.227 0 0 1-1.713 2.45c-.77.68-1.752 1.236-2.945 1.667-1.177.426-2.58.716-4.208.87z"
								transform="translate(12.949 9.359)"
							/>
							<path d="M23.39 9.359c0 .822-.006 1.743-.016 2.762-.01 1.02-.015 2.225-.015 3.615V21.9c0 1.248-.185 2.349-.556 3.302a6.227 6.227 0 0 1-1.712 2.45c-.771.68-1.753 1.236-2.945 1.667-1.192.431-2.615.723-4.269.875l-.928-3.987a16.72 16.72 0 0 0 2.237-.404 4.66 4.66 0 0 0 1.674-.799c.507-.395.89-.892 1.15-1.491.258-.599.387-1.39.387-2.374 0-.792.003-1.626.008-2.504.005-.877.007-1.783.007-2.716 0-1.624-.007-2.915-.022-3.874-.016-.959-.028-1.854-.038-2.686h5.037z" />
						</svg>
					</a>
				)
			}
			{
				SOCIAL_LINKS.email && (
					<a
						href={`mailto:${SOCIAL_LINKS.email}`}
						class="text-[var(--stone)] transition-colors hover:text-[var(--brand)]"
						aria-label="Email"
					>
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
					</a>
				)
			}
		</div>
	</div>
</footer>
