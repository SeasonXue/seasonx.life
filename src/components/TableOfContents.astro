---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length > 0 && (
		<nav
			class="not-prose mb-8 rounded-lg bg-[var(--ivory)] p-4 sm:p-5 border-l-[2px] border-[var(--brand)]"
			aria-label="目录"
		>
			<p class="mb-3 text-sm font-medium text-[var(--fg)] tracking-wide">目录</p>
			<ul class="space-y-1.5 text-sm">
				{items.map((h) => (
					<li class:list={[h.depth === 3 && 'ml-4']}>
						<a
							href={`#${h.slug}`}
							class="text-[var(--olive)] no-underline transition-colors hover:text-[var(--brand)]"
						>
							{h.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}
