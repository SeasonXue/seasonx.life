---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length > 0 && (
		<nav class="not-prose mb-8 rounded-xl border border-[var(--border)] bg-[var(--bg-elevated)] p-4 sm:p-5" aria-label="目录">
			<p class="mb-3 text-sm font-semibold text-[var(--fg)]">目录</p>
			<ul class="space-y-1.5 text-sm">
				{items.map((h) => (
					<li class:list={[h.depth === 3 && 'ml-4']}>
						<a
							href={`#${h.slug}`}
							class="text-[var(--fg-muted)] no-underline hover:text-[var(--accent)] transition-colors"
						>
							{h.text}
						</a>
					</li>
				))}
			</ul>
		</nav>
	)
}
