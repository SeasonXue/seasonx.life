---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BackToTop from '../components/BackToTop.astro';
import CopyUrl from '../components/CopyUrl.astro';
import Giscus from '../components/Giscus.astro';
import LivePhoto from '../components/LivePhoto.astro';
import OnThisPage from '../components/OnThisPage.astro';
import { SITE_AUTHOR } from '../consts';
import { getLive } from '../utils/live-photo';
import { getPublishedPosts, getRelatedPosts } from '../utils/posts';
import { formatReadingTime, getReadingTime } from '../utils/reading-time';
import BaseLayout from './BaseLayout.astro';

type Props = {
	post: CollectionEntry<'blog'>;
	headings: MarkdownHeading[];
	body: string;
};

const { post, headings, body } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroLive, tags, category } = post.data;
const heroLiveMeta = heroLive ? getLive(heroLive) : undefined;
/** OG / social: Live still URL preferred when heroLive is set */
const socialImage = heroLiveMeta?.photo ?? heroImage;
const minutes = getReadingTime(body);
const related = getRelatedPosts(await getPublishedPosts(), post, 4);
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const dateLabel = pubDate.toLocaleDateString('zh-CN', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout
	title={title}
	description={description}
	image={socialImage}
	type="article"
	pubDate={pubDate}
	updatedDate={updatedDate}
	progress
>
	<article class="post-page" data-pagefind-body>
		<div class="post-layout">
			{/* —— Main column —— */}
			<div class="post-content">
				<header>
					{/* Breadcrumb: home + tags */}
					<div class="post-breadcrumb">
						<a href="/" class="post-breadcrumb-home" aria-label="首页">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
								<path d="M224,120v96a8,8,0,0,1-8,8H160a8,8,0,0,1-8-8V164a4,4,0,0,0-4-4H108a4,4,0,0,0-4,4v52a8,8,0,0,1-8,8H40a8,8,0,0,1-8-8V120a16,16,0,0,1,4.69-11.31l80-80a16,16,0,0,1,22.62,0l80,80A16,16,0,0,1,224,120Z"></path>
							</svg>
						</a>
						{
							category && (
								<a href={`/categories/${encodeURIComponent(category)}/`} class="pill">
									{category}
								</a>
							)
						}
						{
							tags.map((tag) => (
								<a href={`/tags/${encodeURIComponent(tag)}/`} class="pill">
									{tag}
								</a>
							))
						}
					</div>

					<hr class="post-header-rule" />

					<time class="post-date" datetime={pubDate.toISOString()}>{dateLabel}</time>

					<h1 class="post-title" data-pagefind-meta="title">{title}</h1>

					<div class="post-byline">
						<span class="post-byline-author">{SITE_AUTHOR}</span>
						<span class="post-byline-sep" aria-hidden="true">·</span>
						<span>{formatReadingTime(minutes)}</span>
						<span class="post-byline-sep" aria-hidden="true">·</span>
						<CopyUrl />
						{
							updatedDate && (
								<>
									<span class="post-byline-sep" aria-hidden="true">·</span>
									<span>
										更新于{' '}
										{updatedDate.toLocaleDateString('zh-CN', {
											year: 'numeric',
											month: 'long',
											day: 'numeric',
										})}
									</span>
								</>
							)
						}
					</div>
				</header>

				{
					heroLiveMeta ? (
						<div class="post-cover post-cover--live">
							<LivePhoto meta={heroLiveMeta} alt={title} autoplayOnce loading="eager" />
						</div>
					) : (
						heroImage && (
							<div class="post-cover">
								<Image
									width={1400}
									height={788}
									src={heroImage}
									alt={title}
									class="h-auto w-full object-cover"
									priority
								/>
							</div>
						)
					)
				}

				{/* Mobile TOC */}
				{
					tocItems.length > 0 && (
						<details class="mobile-toc">
							<summary>本页目录</summary>
							<ul class="otp-list">
								{tocItems.map((h) => (
									<li class:list={[h.depth === 3 && 'otp-h3']}>
										<a href={`#${h.slug}`}>{h.text}</a>
									</li>
								))}
							</ul>
						</details>
					)
				}

				{/* Lead / description as first editorial line */}
				<p class="sr-only" data-pagefind-meta="description">{description}</p>

				<div class="article-content">
					<slot />
				</div>
			</div>

			{/* —— TOC (md+) —— */}
			<aside class="post-toc">
				{tocItems.length > 0 && <OnThisPage headings={headings} />}
			</aside>

			{/* —— Left meta rail (xl) —— */}
			<aside class="post-meta-rail">
				<div class="meta-rail-sticky">
					<p class="meta-rail-label">分享</p>
					<div class="meta-rail-actions">
						<CopyUrl />
						<a
							href="/rss.xml"
							class="copy-url-btn"
							style="text-transform: none; letter-spacing: 0;"
						>
							RSS
						</a>
					</div>
				</div>
			</aside>

			{/* —— Full-bleed rule —— */}
			<div class="post-rule" aria-hidden="true"></div>

			{/* —— Extras: tags + related —— */}
			<section class="post-extras">
				{
					(tags.length > 0 || category) && (
						<div>
							<h2 class="related-heading">相关标签</h2>
							<div class="related-tags">
								{category && (
									<a href={`/categories/${encodeURIComponent(category)}/`} class="pill">
										{category}
									</a>
								)}
								{tags.map((tag) => (
									<a href={`/tags/${encodeURIComponent(tag)}/`} class="pill">
										{tag}
									</a>
								))}
							</div>
						</div>
					)
				}

				{
					related.length > 0 && (
						<div>
							<h2 class="related-heading">相关文章</h2>
							<ul class="related-posts-grid">
								{related.map((p) => (
									<li>
										<span class="date">
											{p.data.pubDate.toLocaleDateString('zh-CN', {
												year: 'numeric',
												month: 'long',
												day: 'numeric',
											})}
										</span>
										<a href={`/blog/${p.id}/`}>{p.data.title}</a>
										<p class="line-clamp-2">{p.data.description}</p>
									</li>
								))}
							</ul>
						</div>
					)
				}
			</section>

			{/* —— Comments —— */}
			<div class="post-comments">
				<Giscus />
			</div>
		</div>
	</article>

	<BackToTop />
</BaseLayout>
