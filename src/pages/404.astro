---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在或已被移动。">
	<div class="section-rule">
		<div class="page-frame page-pad">
			<p class="text-sm font-medium tracking-wide text-[var(--fg-meta)]">404</p>
			<h1 class="page-title mt-2">页面未找到</h1>
			<p class="page-description">
				链接可能已失效，或地址写错了。你可以返回首页继续浏览。
			</p>
			<p class="mt-8">
				<a
					href="/"
					class="inline-flex items-center gap-1 font-medium text-[var(--accent)] underline-offset-4 hover:underline"
				>
					← 返回首页
				</a>
			</p>
		</div>
	</div>
</BaseLayout>
