---
import PostFeed from '../../components/PostFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description={`${SITE_TITLE} 的全部文章`}>
	<div class="feed-band feed-band--connectors">
		<div class="feed-frame feed-frame--rails">
			<header class="feed-pad">
				<h1 class="feed-page-title">文章</h1>
				<p class="feed-page-description">
					共 {posts.length} 篇 · {SITE_DESCRIPTION}
				</p>
			</header>
		</div>
	</div>

	<PostFeed posts={posts} featuredFirst pageSize={12} />
</BaseLayout>
