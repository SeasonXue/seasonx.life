---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description={`${SITE_TITLE} 的全部文章`}>
	<header class="mb-8">
		<h1 class="text-3xl font-bold tracking-tight text-[var(--fg)]">文章</h1>
		<p class="mt-2 text-[var(--fg-muted)]">共 {posts.length} 篇</p>
	</header>

	{
		posts.length === 0 ? (
			<p class="text-[var(--fg-muted)]">暂无文章。</p>
		) : (
			<div class="grid gap-6 sm:grid-cols-2">
				{posts.map((post, i) => (
					<PostCard post={post} featured={i === 0} />
				))}
			</div>
		)
	}
</BaseLayout>
