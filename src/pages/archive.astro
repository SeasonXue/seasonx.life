---
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { getPublishedPosts, groupPostsByYear } from '../utils/posts';

const posts = await getPublishedPosts();
const byYear = groupPostsByYear(posts);
---

<BaseLayout title="归档" description={`${SITE_TITLE} 文章归档`}>
	<div class="feed-band feed-band--connectors">
		<div class="feed-frame feed-frame--rails">
			<header class="feed-pad">
				<h1 class="feed-page-title">归档</h1>
				<p class="feed-page-description">按时间浏览全部 {posts.length} 篇文章</p>
			</header>
		</div>
	</div>

	{
		posts.length === 0 ? (
			<div class="feed-band">
				<div class="feed-frame feed-frame--rails">
					<div class="feed-pad">
						<p class="feed-empty">暂无文章。</p>
					</div>
				</div>
			</div>
		) : (
			[...byYear.entries()].map(([year, yearPosts]) => (
				<section class="feed-band">
					<div class="feed-frame feed-frame--rails">
						<div class="feed-pad">
							<h2 class="m-0 mb-5 text-xl font-medium text-[var(--fg)]">
								{year}
								<span class="ms-2 text-sm font-normal text-[var(--stone)] normal-case tracking-normal">
									({yearPosts.length})
								</span>
							</h2>
							<ul class="m-0 list-none space-y-0 p-0">
								{yearPosts.map((post) => (
									<li class="flex flex-col gap-1 border-b border-dashed border-[var(--border)] py-3 last:border-0 sm:flex-row sm:items-baseline sm:gap-6">
										<span class="feed-date w-36 shrink-0">
											<FormattedDate date={post.data.pubDate} />
										</span>
										<a
											href={`/blog/${post.id}/`}
											class="font-medium text-[var(--fg)] no-underline transition-colors duration-150 hover:text-[var(--accent)]"
										>
											{post.data.title}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>
				</section>
			))
		)
	}
</BaseLayout>
