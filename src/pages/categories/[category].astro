---
import PostFeed from '../../components/PostFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
	getAllCategories,
	getPostsByCategory,
	getPublishedPosts,
} from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const categories = getAllCategories(posts);
	return [...categories.keys()].map((category) => ({
		params: { category },
		props: { category },
	}));
}

const { category } = Astro.props;
const all = await getPublishedPosts();
const posts = getPostsByCategory(all, category);
---

<BaseLayout title={`分类：${category}`} description={`分类「${category}」下的文章`}>
	<div class="feed-band feed-band--connectors">
		<div class="feed-frame feed-frame--rails">
			<header class="feed-pad">
				<p class="feed-date" style="margin-bottom: 0.75rem; text-transform: none; letter-spacing: 0;">
					<a href="/categories" class="text-[var(--accent)] no-underline hover:underline">分类</a>
					<span class="mx-1">/</span>
					{category}
				</p>
				<h1 class="feed-page-title">{category}</h1>
				<p class="feed-page-description">{posts.length} 篇文章</p>
			</header>
		</div>
	</div>

	<PostFeed posts={posts} featuredFirst={false} pageSize={12} />
</BaseLayout>
