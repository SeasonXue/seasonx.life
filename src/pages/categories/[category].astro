---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllCategories, getPostsByCategory, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const categories = getAllCategories(posts);
	return [...categories.keys()].map((category) => ({
		params: { category },
		props: { category },
	}));
}

const { category } = Astro.props;
const posts = getPostsByCategory(await getPublishedPosts(), category);
---

<BaseLayout title={`分类：${category}`} description={`分类「${category}」下的文章`}>
	<header class="mb-8">
		<p class="text-sm text-[var(--fg-muted)]">
			<a href="/categories" class="text-[var(--accent)] no-underline hover:underline">分类</a>
			<span class="mx-1">/</span>
		</p>
		<h1 class="mt-1 text-3xl font-bold tracking-tight text-[var(--fg)]">{category}</h1>
		<p class="mt-2 text-[var(--fg-muted)]">{posts.length} 篇文章</p>
	</header>

	<div class="grid gap-6 sm:grid-cols-2">
		{posts.map((post) => <PostCard post={post} />)}
	</div>
</BaseLayout>
