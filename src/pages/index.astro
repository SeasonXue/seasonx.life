---
import PostCard from '../components/PostCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="mb-14 border-b border-[var(--border-soft)] pb-12">
		<p class="mb-3 text-xs font-medium uppercase tracking-[1.2px] text-[var(--stone)]">
			Personal blog
		</p>
		<h1 class="text-[2rem] font-medium leading-[1.15] tracking-tight text-[var(--fg)] sm:text-[2.5rem]">
			你好，我是 {SITE_TITLE}
		</h1>
		<p class="mt-4 max-w-xl text-lg leading-relaxed text-[var(--olive)]">
			{SITE_DESCRIPTION}
		</p>
		<div class="mt-7 flex flex-wrap gap-3">
			<a href="/blog" class="btn btn-primary">浏览文章</a>
			<a href="/about" class="btn btn-ghost">关于我</a>
		</div>
	</section>

	<section>
		<div class="mb-6 flex items-end justify-between gap-4">
			<h2 class="text-xl font-medium text-[var(--fg)]">最新文章</h2>
			<a
				href="/blog"
				class="text-sm font-medium text-[var(--accent)] no-underline transition-colors hover:text-[var(--accent-hover)]"
			>
				查看全部 →
			</a>
		</div>
		{
			posts.length === 0 ? (
				<p class="text-[var(--olive)]">暂无文章。</p>
			) : (
				<div class="grid gap-5 sm:grid-cols-2">
					{posts.map((post, i) => (
						<PostCard post={post} featured={i === 0} />
					))}
				</div>
			)
		}
	</section>
</BaseLayout>
