---
import PostFeed from '../components/PostFeed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts } from '../utils/posts';

const posts = await getPublishedPosts();
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	{/* Page header — CF: full-bleed dashed band + title */}
	<div class="feed-band feed-band--connectors">
		<div class="feed-frame feed-frame--rails">
			<header class="feed-pad">
				<h1 class="feed-page-title">{SITE_TITLE}</h1>
				<p class="feed-page-description">{SITE_DESCRIPTION}</p>
			</header>
		</div>
	</div>

	<PostFeed posts={posts} featuredFirst pageSize={12} />
</BaseLayout>
