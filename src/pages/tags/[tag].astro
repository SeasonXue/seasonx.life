---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = getAllTags(posts);
	return [...tags.keys()].map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

const { tag } = Astro.props;
const posts = getPostsByTag(await getPublishedPosts(), tag);
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的文章`}>
	<header class="mb-8">
		<p class="text-sm text-[var(--fg-muted)]">
			<a href="/tags" class="text-[var(--accent)] no-underline hover:underline">标签</a>
			<span class="mx-1">/</span>
		</p>
		<h1 class="mt-1 text-3xl font-bold tracking-tight text-[var(--fg)]">#{tag}</h1>
		<p class="mt-2 text-[var(--fg-muted)]">{posts.length} 篇文章</p>
	</header>

	<div class="grid gap-6 sm:grid-cols-2">
		{posts.map((post) => <PostCard post={post} />)}
	</div>
</BaseLayout>
