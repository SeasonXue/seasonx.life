---
import PostFeed from '../../components/PostFeed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, getPublishedPosts } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const tags = getAllTags(posts);
	return [...tags.keys()].map((tag) => ({
		params: { tag },
		props: { tag },
	}));
}

const { tag } = Astro.props;
const posts = getPostsByTag(await getPublishedPosts(), tag);
---

<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的文章`}>
	<div class="feed-band feed-band--connectors">
		<div class="feed-frame feed-frame--rails">
			<header class="feed-pad">
				<p class="feed-date" style="margin-bottom: 0.75rem; text-transform: none; letter-spacing: 0;">
					<a href="/tags" class="text-[var(--accent)] no-underline hover:underline">标签</a>
					<span class="mx-1">/</span>
					#{tag}
				</p>
				<h1 class="feed-page-title">#{tag}</h1>
				<p class="feed-page-description">{posts.length} 篇文章</p>
			</header>
		</div>
	</div>

	<PostFeed posts={posts} featuredFirst={false} pageSize={12} />
</BaseLayout>
