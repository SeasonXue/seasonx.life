---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags, getPublishedPosts } from '../../utils/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
const max = Math.max(...tags.values(), 1);
---

<BaseLayout title="标签" description={`${SITE_TITLE} 全部标签`}>
	<header class="mb-10">
		<h1 class="text-3xl font-bold tracking-tight text-[var(--fg)]">标签</h1>
		<p class="mt-2 text-[var(--fg-muted)]">共 {tags.size} 个标签</p>
	</header>

	{
		tags.size === 0 ? (
			<p class="text-[var(--fg-muted)]">暂无标签。</p>
		) : (
			<div class="flex flex-wrap gap-3">
				{[...tags.entries()].map(([tag, count]) => {
					const scale = 0.85 + (count / max) * 0.4;
					return (
						<a
							href={`/tags/${encodeURIComponent(tag)}/`}
							class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-elevated)] px-4 py-2 no-underline transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]"
							style={`font-size: ${scale}rem`}
						>
							<span class="font-medium">#{tag}</span>
							<span class="text-xs text-[var(--fg-muted)]">{count}</span>
						</a>
					);
				})}
			</div>
		)
	}
</BaseLayout>
