# Global security baseline + CSP
# CSP allows: self assets (incl. /fonts), Giscus comments, CF Web Analytics, Pagefind workers + WASM
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data: blob: https:; media-src 'self' https: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline' https://giscus.app; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://giscus.app https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com https://giscus.app; frame-src https://giscus.app; worker-src 'self' blob:; upgrade-insecure-requests

# Fingerprinted Astro assets — long-lived browser cache
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted typefaces — long-lived cache
# CORS: giscus iframe (giscus.app) loads these via theme @font-face
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, OPTIONS

# Giscus custom theme (iframe stylesheet)
/giscus-theme.css
  Cache-Control: public, max-age=86400, must-revalidate
  Access-Control-Allow-Origin: *

# Pagefind search index / UI — revalidate daily
/pagefind/*
  Cache-Control: public, max-age=86400, must-revalidate

# Keep preview / workers.dev out of search indexes
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
